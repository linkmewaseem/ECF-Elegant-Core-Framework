{
  "name": "@ecfjs/queue",
  "version": "1.0.0-rc.1",
  "description": "ECF job queue system with Sync, Memory, Database, and Redis drivers, retries, delayed jobs, and batch processing",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "queue",
    "jobs",
    "workers",
    "background-jobs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/queue"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/cache": "workspace:*",
    "@ecfjs/database": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/config": {
      "optional": true
    },
    "@ecfjs/events": {
      "optional": true
    },
    "@ecfjs/cache": {
      "optional": true
    },
    "@ecfjs/database": {
      "optional": true
    }
  }
}