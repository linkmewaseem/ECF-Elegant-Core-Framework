<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ name }} - ECF App</title>
</head>
<body>
    @if(name)
        <h1>Welcome, {{ name }}!</h1>
    @endif

    <p>Let's explore the features and capabilities of ECF.</p>
    <hr>

    @if(name)
        <p><strong>Name:</strong> {{ name }}</p>
    @endif
    <p><strong>Age:</strong> {{ age }}</p>
    <p><strong>Date:</strong> {{ date }}</p>

    <h3>Active Users (Rendered via ECF loop)</h3>
{{waseem}}
    <ul>
    @for(users as user, i)
        @continue(user.disabled)
        <li>
            #{{ i }}: <a href="/users/name/{{ user.name }}"><strong>{{ user.name }}</strong></a> ({{ user.email }}) - <em>{{ user.role }}</em>
        </li>
    @endfor
    </ul>

</body>
</html>