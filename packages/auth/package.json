{
  "name": "@ecfjs/auth",
  "version": "1.0.0-rc.1",
  "description": "ECF authentication system with guards, JWT, session management, and multi-driver auth pipelines",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "auth",
    "authentication",
    "jwt",
    "guards",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/auth"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/events": "workspace:*",
    "@ecfjs/config": "workspace:*",
    "@ecfjs/cache": "workspace:*",
    "@ecfjs/database": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/events": {
      "optional": true
    },
    "@ecf/config": {
      "optional": true
    },
    "@ecf/cache": {
      "optional": true
    },
    "@ecf/database": {
      "optional": true
    }
  }
}