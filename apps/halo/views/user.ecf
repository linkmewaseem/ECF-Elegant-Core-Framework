@extends('layouts.app')

@section('content')
    <h1 class="header-title">Users Directory</h1>

    <h2>Active Users</h2>
    @for(users as user)
        @continue(user.disabled)
        @include("partials.user-row", { user: user })
    @endfor

    <h2 style="margin-top: 2rem;">All Accounts & Status</h2>
    @for(users as user)
        @include("partials.user-row", { user: user })
    @endfor
@endsection