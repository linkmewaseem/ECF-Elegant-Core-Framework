{
  "name": "@ecfjs/mail",
  "version": "1.0.0",
  "description": "ECF Enterprise Mail Platform — SMTP socket transport, Resend REST API, Mailable classes, queued delivery, CSS-inlined Markdown templates, attachments, and testing fakes.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "mail",
    "email",
    "smtp",
    "resend",
    "mailer",
    "mailable",
    "nodemailer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/mail"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*",
    "@ecfjs/queue": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/view": "workspace:*",
    "@ecfjs/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/config": {
      "optional": true
    },
    "@ecfjs/events": {
      "optional": true
    },
    "@ecfjs/view": {
      "optional": true
    },
    "@ecfjs/storage": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
}
