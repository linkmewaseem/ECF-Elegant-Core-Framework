{
  "name": "@ecf/api",
  "version": "1.0.0-rc.1",
  "description": "ECF API platform with automated OpenAPI generation, JSON:API resources, versioning, and rate limiting",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "api", "openapi", "rest", "json-api", "versioning"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/api"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/contracts": "workspace:*",
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/auth": "workspace:*",
    "@ecf/cache": "workspace:*",
    "@ecf/config": "workspace:*",
    "@ecf/http": "workspace:*",
    "@ecf/observability": "workspace:*",
    "@ecf/devtools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/auth": { "optional": true },
    "@ecf/cache": { "optional": true },
    "@ecf/config": { "optional": true },
    "@ecf/http": { "optional": true },
    "@ecf/observability": { "optional": true },
    "@ecf/devtools": { "optional": true }
  }
}
