{
  "name": "@ecf/devkit",
  "version": "1.0.0-rc.1",
  "description": "ECF developer toolkit with AST code injection, YAML blueprint compiler, and ecf doctor/validate commands",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "devkit", "codegen", "ast", "scaffold", "blueprint"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/devkit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/console": "workspace:*",
    "@ecf/contracts": "workspace:*",
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/cli": "workspace:*",
    "@ecf/config": "workspace:*",
    "@ecf/database": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/cli": { "optional": true },
    "@ecf/config": { "optional": true },
    "@ecf/database": { "optional": true }
  }
}
