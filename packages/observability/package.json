    "directory": "packages/observability"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/events": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/events": { "optional": true }
