{
  "name": "@ecfjs/upload",
  "version": "1.0.0-rc.5",
  "description": "ECF file upload middleware with multipart parsing, MIME validation, size limits, and storage routing",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "upload",
    "file-upload",
    "multipart",
    "mime",
    "storage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/upload"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*",
    "@ecfjs/storage": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/validation": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/config": {
      "optional": true
    },
    "@ecfjs/events": {
      "optional": true
    },
    "@ecfjs/validation": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
}
