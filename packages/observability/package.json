{
  "name": "@ecfjs/observability",
  "version": "1.0.0-rc.5",
  "description": "ECF OpenTelemetry observability package for distributed tracing, metrics, and span instrumentation",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "observability",
    "opentelemetry",
    "tracing",
    "metrics",
    "spans"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/observability"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/events": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/events": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
}
