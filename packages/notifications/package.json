{
  "name": "@ecfjs/notifications",
  "version": "1.0.0-rc.1",
  "description": "ECF multi-channel notification system for email, SMS, Slack, push, and in-app notifications",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "notifications",
    "email",
    "sms",
    "push",
    "alerts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/notifications"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*",
    "@ecfjs/mail": "workspace:*",
    "@ecfjs/queue": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/database": "workspace:*",
    "@ecfjs/cache": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/config": {
      "optional": true
    },
    "@ecf/events": {
      "optional": true
    },
    "@ecf/database": {
      "optional": true
    },
    "@ecf/cache": {
      "optional": true
    }
  }
}