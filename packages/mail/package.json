{
  "name": "@ecf/mail",
  "version": "1.0.0-rc.1",
  "description": "ECF mail system with Nodemailer integration, Mailable classes, queued delivery, and template rendering",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "mail", "email", "nodemailer", "smtp", "mailer"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/mail"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*",
    "@ecf/queue": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/config": "workspace:*",
    "@ecf/events": "workspace:*",
    "@ecf/view": "workspace:*",
    "@ecf/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/config": { "optional": true },
    "@ecf/events": { "optional": true },
    "@ecf/view": { "optional": true },
    "@ecf/storage": { "optional": true }
  }
}
