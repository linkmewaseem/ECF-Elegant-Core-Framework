{
  "name": "@ecfjs/ai",
  "version": "1.0.0",
  "description": "ECF Enterprise AI Platform — Multi-driver LLM engine (OpenAI, Anthropic, Gemini, Groq, Ollama, OpenRouter), streaming, RAG pipeline, Model Context Protocol (MCP), and testing fakes.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "groq",
    "ollama",
    "openrouter",
    "rag",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/ai"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/contracts": "workspace:*",
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/devtools": "workspace:*",
    "@ecfjs/logging": "workspace:*",
    "@ecfjs/media": "workspace:*",
    "@ecfjs/search": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/devtools": {
      "optional": true
    },
    "@ecfjs/logging": {
      "optional": true
    },
    "@ecfjs/media": {
      "optional": true
    },
    "@ecfjs/search": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
