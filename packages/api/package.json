{
  "name": "@ecfjs/api",
  "version": "1.0.0-rc.2",
  "description": "ECF API platform with automated OpenAPI generation, JSON:API resources, versioning, and rate limiting",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "api",
    "openapi",
    "rest",
    "json-api",
    "versioning"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/api"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/contracts": "workspace:*",
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/auth": "workspace:*",
    "@ecfjs/cache": "workspace:*",
    "@ecfjs/config": "workspace:*",
    "@ecfjs/http": "workspace:*",
    "@ecfjs/observability": "workspace:*",
    "@ecfjs/devtools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/auth": {
      "optional": true
    },
    "@ecfjs/cache": {
      "optional": true
    },
    "@ecfjs/config": {
      "optional": true
    },
    "@ecfjs/http": {
      "optional": true
    },
    "@ecfjs/observability": {
      "optional": true
    },
    "@ecfjs/devtools": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
}
