{
  "name": "@ecf/upload",
  "version": "1.0.0-rc.1",
  "description": "ECF file upload middleware with multipart parsing, MIME validation, size limits, and storage routing",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "upload", "file-upload", "multipart", "mime", "storage"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/upload"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*",
    "@ecf/storage": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/config": "workspace:*",
    "@ecf/events": "workspace:*",
    "@ecf/validation": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/config": { "optional": true },
    "@ecf/events": { "optional": true },
    "@ecf/validation": { "optional": true }
  }
}
