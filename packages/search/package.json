{
  "name": "@ecf/search",
  "version": "1.0.0-rc.1",
  "description": "ECF search platform with vector embeddings, full-text search, faceting, and ReRanker pipeline",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "search", "vector-search", "full-text", "elasticsearch", "meilisearch"],
  "license": "MIT",
  "repository": {
    "type": "git",
