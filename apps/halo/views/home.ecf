@section('content')
    <h1 class="header-title">Welcome, {{ name }}!</h1>
    <p>Let's explore the features and capabilities of ECF View Engine.</p>

    <div class="card">
    <p><strong>Name:</strong> {{ name }}</p>
    <p><strong>Age Status:</strong> {{ age >= 18 ? 'Adult (' + age + ')' : 'Minor (' + age + ')' }}</p>
    <p><strong>Server Date:</strong> {{ date }}</p>
