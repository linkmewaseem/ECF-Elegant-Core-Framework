{
  "name": "@ecf/media",
  "version": "1.0.0-rc.1",
  "description": "ECF media processing package for image resizing, audio/video transcoding, and responsive variants",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "media", "image", "resize", "sharp", "video", "audio"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/media"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*",
    "@ecf/queue": "workspace:*",
    "@ecf/storage": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/config": "workspace:*",
    "@ecf/events": "workspace:*",
    "@ecf/upload": "workspace:*",
    "@ecf/notifications": "workspace:*",
    "sharp": "^0.33.5"
  },
  "peerDependenciesMeta": {
    "@ecf/config": { "optional": true },
    "@ecf/events": { "optional": true },
    "@ecf/upload": { "optional": true },
    "@ecf/notifications": { "optional": true },
    "sharp": { "optional": true }
  }
}
