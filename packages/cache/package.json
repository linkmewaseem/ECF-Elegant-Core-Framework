{
  "name": "@ecfjs/cache",
  "version": "1.0.0-rc.1",
  "description": "ECF cache layer with stampede protection, multi-driver support, and tagged cache invalidation",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "ecf",
    "framework",
    "cache",
    "redis",
    "memory-cache",
    "stampede"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/cache"
  },
  "files": ["src", "README.md", "ARCHITECTURE.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/core": "workspace:*",
