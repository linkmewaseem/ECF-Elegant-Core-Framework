    "@ecfjs/view": "^1.0.0-rc.5",
    "@ecfjs/database": "^1.0.0-rc.7",
    "@ecfjs/auth": "^1.0.0-rc.5",
    "@ecfjs/validation": "^1.0.0-rc.5",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "author": "Muhammad Waseem"
}
