{
  "name": "@ecf/broadcast",
  "version": "1.0.0-rc.1",
  "description": "ECF realtime broadcast system with WebSocket channels, presence, and event-driven pub-sub",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "broadcast", "websocket", "realtime", "channels", "pub-sub"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/broadcast"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/contracts": "workspace:*",
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/config": "workspace:*",
    "@ecf/events": "workspace:*",
    "@ecf/queue": "workspace:*",
    "@ecf/notifications": "workspace:*",
    "@ecf/observability": "workspace:*",
    "@ecf/devtools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/config": { "optional": true },
    "@ecf/events": { "optional": true },
    "@ecf/queue": { "optional": true },
    "@ecf/notifications": { "optional": true },
    "@ecf/observability": { "optional": true },
    "@ecf/devtools": { "optional": true }
  }
}
