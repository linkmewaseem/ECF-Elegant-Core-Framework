{
  "name": "@ecfjs/testing",
  "version": "1.0.0-rc.1",
  "description": "ECF testing toolkit with DI contexts, HTTP assertions, model factories, time travel, snapshots, and benchmarks",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser/index.d.ts",
      "default": "./src/browser/BrowserAgent.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "testing",
    "test-helpers",
    "factory",
    "assertions",
    "benchmarks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/contracts": "workspace:*",
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/api": "workspace:*",
    "@ecfjs/auth": "workspace:*",
    "@ecfjs/broadcast": "workspace:*",
    "@ecfjs/database": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/http": "workspace:*",
    "@ecfjs/logging": "workspace:*",
    "@ecfjs/mail": "workspace:*",
    "@ecfjs/notifications": "workspace:*",
    "@ecfjs/queue": "workspace:*",
    "@ecfjs/search": "workspace:*",
    "@ecfjs/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/api": {
      "optional": true
    },
    "@ecfjs/auth": {
      "optional": true
    },
    "@ecfjs/broadcast": {
      "optional": true
    },
    "@ecfjs/database": {
      "optional": true
    },
    "@ecfjs/events": {
      "optional": true
    },
    "@ecfjs/http": {
      "optional": true
    },
    "@ecfjs/logging": {
      "optional": true
    },
    "@ecfjs/mail": {
      "optional": true
    },
    "@ecfjs/notifications": {
      "optional": true
    },
    "@ecfjs/queue": {
      "optional": true
    },
    "@ecfjs/search": {
      "optional": true
    },
    "@ecfjs/storage": {
      "optional": true
    }
  }
}