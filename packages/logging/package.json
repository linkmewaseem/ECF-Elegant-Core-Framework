{
  "name": "@ecfjs/logging",
  "version": "1.0.0-rc.1",
  "description": "ECF logging system with 12 drivers, multi-channel rotation, gzip compression, OpenTelemetry tracing, and PII redaction",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "logging",
    "logger",
    "winston",
    "pino",
    "opentelemetry",
    "tracing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/logging"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/contracts": "workspace:*",
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/devtools": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/mail": "workspace:*",
    "@ecfjs/observability": "workspace:*",
    "@ecfjs/queue": "workspace:*",
    "@ecfjs/search": "workspace:*",
    "@ecfjs/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/config": {
      "optional": true
    },
    "@ecf/devtools": {
      "optional": true
    },
    "@ecf/events": {
      "optional": true
    },
    "@ecf/mail": {
      "optional": true
    },
    "@ecf/observability": {
      "optional": true
    },
    "@ecf/queue": {
      "optional": true
    },
    "@ecf/search": {
      "optional": true
    },
    "@ecf/storage": {
      "optional": true
    }
  }
}