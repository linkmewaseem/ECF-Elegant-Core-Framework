{
  "name": "@ecfjs/media",
  "version": "1.0.0-rc.1",
  "description": "ECF media processing package for image resizing, audio/video transcoding, and responsive variants",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "media",
    "image",
    "resize",
    "sharp",
    "video",
    "audio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/media"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*",
    "@ecfjs/queue": "workspace:*",
    "@ecfjs/storage": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/config": "workspace:*",
    "@ecfjs/events": "workspace:*",
    "@ecfjs/upload": "workspace:*",
    "@ecfjs/notifications": "workspace:*",
    "sharp": "^0.33.5"
  },
  "peerDependenciesMeta": {
    "@ecfjs/config": {
      "optional": true
    },
    "@ecfjs/events": {
      "optional": true
    },
    "@ecfjs/upload": {
      "optional": true
    },
    "@ecfjs/notifications": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
}
