{
  "name": "@ecf/testing",
  "version": "1.0.0-rc.1",
  "description": "ECF testing toolkit with DI contexts, HTTP assertions, model factories, time travel, snapshots, and benchmarks",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser/index.d.ts",
      "default": "./src/browser/BrowserAgent.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "testing", "test-helpers", "factory", "assertions", "benchmarks"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecf/contracts": "workspace:*",
    "@ecf/core": "workspace:*",
    "@ecf/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecf/api": "workspace:*",
    "@ecf/auth": "workspace:*",
    "@ecf/broadcast": "workspace:*",
    "@ecf/database": "workspace:*",
    "@ecf/events": "workspace:*",
    "@ecf/http": "workspace:*",
    "@ecf/logging": "workspace:*",
    "@ecf/mail": "workspace:*",
    "@ecf/notifications": "workspace:*",
    "@ecf/queue": "workspace:*",
    "@ecf/search": "workspace:*",
    "@ecf/storage": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecf/api": { "optional": true },
    "@ecf/auth": { "optional": true },
    "@ecf/broadcast": { "optional": true },
    "@ecf/database": { "optional": true },
    "@ecf/events": { "optional": true },
    "@ecf/http": { "optional": true },
    "@ecf/logging": { "optional": true },
    "@ecf/mail": { "optional": true },
    "@ecf/notifications": { "optional": true },
    "@ecf/queue": { "optional": true },
    "@ecf/search": { "optional": true },
    "@ecf/storage": { "optional": true }
  }
}
