@extends('layouts.app')

@section('content')
    <h1 class="header-title" style="color: #991b1b;">User Not Found</h1>
    <p>No user found matching search query: <strong>"{{ searchParam }}"</strong></p>

    @if(suggestions && suggestions.length > 0)
        <div class="card">
            <h3>Did you mean?</h3>
            <ul>
                @for(suggestions as sugg)
                    <li><a href="/users/name/{{ sugg.name }}">{{ sugg.name }}</a> ({{ sugg.email }})</li>
                @endfor
            </ul>
        </div>
    @endif

    <p><a href="/users">← View all users</a></p>
@endsection
