{
  "name": "@ecfjs/devkit",
  "version": "1.0.0-rc.3",
  "description": "ECF developer toolkit with AST code injection, YAML blueprint compiler, and ecf doctor/validate commands",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "ecf",
    "framework",
    "devkit",
    "codegen",
    "ast",
    "scaffold",
    "blueprint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkmewaseem/ECF-Elegant-Core-Framework.git",
    "directory": "packages/devkit"
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ecfjs/console": "workspace:*",
    "@ecfjs/contracts": "workspace:*",
    "@ecfjs/core": "workspace:*",
    "@ecfjs/support": "workspace:*"
  },
  "peerDependencies": {
    "@ecfjs/cli": "workspace:*",
    "@ecfjs/config": "workspace:*",
    "@ecfjs/database": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ecfjs/cli": {
      "optional": true
    },
    "@ecfjs/config": {
      "optional": true
    },
    "@ecfjs/database": {
      "optional": true
    }
  },
  "author": "Muhammad Waseem"
}
