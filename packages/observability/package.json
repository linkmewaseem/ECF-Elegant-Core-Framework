{
  "name": "@ecf/observability",
  "version": "1.0.0-rc.1",
  "description": "ECF OpenTelemetry observability package for distributed tracing, metrics, and span instrumentation",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": ["ecf", "framework", "observability", "opentelemetry", "tracing", "metrics", "spans"],
  "license": "MIT",
  "repository": {
    "type": "git",
